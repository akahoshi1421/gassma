{
  "name": "gassma",
  "version": "10",
  "description": "GASsma is Google Apps Script(GAS) of SpreadSheet library that can be used like prisma.",
  "types": "src/index.d.ts",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.mjs",
    "verify:bundle": "npm run build && node scripts/verifyBundleGlobals.js",
    "push": "npm run build && clasp push",
    "test": "jest",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "prepare": "husky"
  },
  "author": "akahoshi1421",
  "license": "MIT",
  "dependencies": {
    "@types/google-apps-script": "^1.0.83"
  },
  "keywords": [
    "Google Apps Script",
    "TypeScript",
    "JavaScript",
    "GASsma"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@types/jest": "^29.5.14",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "biome format --write",
      "biome lint --write"
    ]
  }
}
